#version 450

// 逐块的高斯泼溅：一个工作组负责一个 tile，一个线程负责 tile 里的一个像素。
// 高斯列表在 CPU 侧按深度排好序并按 tile 分桶，因此这里只需顺序做前向 alpha 合成。
//
// 结构体刻意全部用 vec4，避免 std430 里 vec3 对齐带来的两侧布局歧义。

layout(local_size_x = 16, local_size_y = 16) in;

struct Splat {
    vec4 centerAndInverseScale;  // centerX, centerY, 1/sx^2, 1/sy^2
    vec4 radiusAndAlpha;         // radius, alphaScale, 未用, 未用
    vec4 color;                  // r, g, b, 未用
};

layout(std430, binding = 0) readonly buffer Splats {
    Splat splats[];
};

// 每个 tile 两个 uint：[起始下标, 数量]
layout(std430, binding = 1) readonly buffer TileRanges {
    uint tileRanges[];
};

layout(std430, binding = 2) readonly buffer TileItems {
    uint tileItems[];
};

layout(binding = 3, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint tilesX;
    uint tileSize;
} pc;

const float kShC0 = 0.28209479177387814;

void main() {
    const uint tileX = gl_WorkGroupID.x;
    const uint tileY = gl_WorkGroupID.y;
    const uint px = tileX * pc.tileSize + gl_LocalInvocationID.x;
    const uint py = tileY * pc.tileSize + gl_LocalInvocationID.y;
    if (px >= pc.width || py >= pc.height) {
        return;
    }

    const uint tileIndex = tileY * pc.tilesX + tileX;
    const uint offset = tileRanges[tileIndex * 2u];
    const uint count = tileRanges[tileIndex * 2u + 1u];

    const vec2 pixel = vec2(float(px) + 0.5, float(py) + 0.5);
    float transmittance = 1.0;
    vec3 accum = vec3(0.0);

    for (uint i = 0u; i < count; ++i) {
        const Splat splat = splats[tileItems[offset + i]];
        const vec2 center = splat.centerAndInverseScale.xy;
        const vec2 inverseScale = splat.centerAndInverseScale.zw;
        const float radius = splat.radiusAndAlpha.x;
        const float alphaScale = splat.radiusAndAlpha.y;

        const vec2 delta = pixel - center;
        if (abs(delta.x) > radius || abs(delta.y) > radius) {
            continue;
        }
        const float power = -0.5 * (delta.x * delta.x * inverseScale.x +
                                    delta.y * delta.y * inverseScale.y);
        if (power < -9.0) {
            continue;
        }
        const float alpha = clamp(alphaScale * exp(power), 0.0, 0.99);
        if (alpha < 0.0039) {
            continue;
        }
        accum += transmittance * alpha * splat.color.rgb;
        transmittance *= (1.0 - alpha);
        if (transmittance < 0.01) {
            break;
        }
    }

    const vec3 color = clamp(vec3(0.5) + kShC0 * accum, 0.0, 1.0);
    imageStore(outImage, ivec2(px, py), vec4(color, 1.0));
}